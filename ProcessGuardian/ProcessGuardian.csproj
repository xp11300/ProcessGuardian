<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ProcessGuardian.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright &#169; 2026 Jasper Young</Copyright>
    <Product>Process Guardian</Product>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;FaultInjection</Configurations>
  </PropertyGroup>

  <!-- Stage-12 startup fault injection: test-only configuration. Debug and Release never define PG_FAULT_INJECTION. -->
  <PropertyGroup Condition="'$(Configuration)'=='FaultInjection'">
    <DefineConstants>$(DefineConstants);PG_FAULT_INJECTION</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ProcessGuardian.ico" />
  </ItemGroup>

</Project>
